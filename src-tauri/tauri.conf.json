{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkFolio",
  "mainBinaryName": "MarkFolio",
  "identifier": "dev.markfolio.app",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkFolio",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' blob: 'wasm-unsafe-eval'; font-src 'self' data:; object-src 'none'; media-src 'self' data: blob:; worker-src 'self' blob:",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' blob: 'wasm-unsafe-eval' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; media-src 'self' data: blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../README.md": "README.md",
      "../CHANGELOG.md": "CHANGELOG.md",
      "../ROADMAP.md": "ROADMAP.md",
      "../public/third-party/": "third-party/",
      "../docs/": "docs/",
      "../browser-extension/": "browser-extension/",
      "../examples/plugins/": "examples/plugins/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "language": "zh-CN" },
      "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": true },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "markfolio"
        ]
      }
    }
  }
}
